# 默认 true：不联网、不花钱，使用确定性 Mock 模型跑通全流程。
OPENROUTER_MOCK=true
OPENROUTER_API_KEY=
# 真实模式还需要另一个独立的预览访问令牌（至少 32 字符）。
# 仅通过部署环境的服务端 Secrets 配置，不要提交真实值。
DEBATE_ROOM_API_TOKEN=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DATABASE_PATH=data/debate_room.db
SCENARIO_CONFIG=config/scenarios.yaml
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES_PER_MODEL=1

# 以下 GitHub 集成仅供本地演示；真实预览会禁用 Webhook 和外部回调。
GITHUB_WEBHOOK_SECRET=
# 仅当需要把代码评审结果自动回发 PR 评论时配置。
GITHUB_TOKEN=

# 真实预览默认使用无需密钥的 Wikipedia 公开检索；Mock 始终不检索。
# wikimedia | none（关闭）| brave（需单独授权、正确方案与额度）
FACT_SEARCH_PROVIDER=wikimedia
# 部署者应提供公开、可联系的项目页面（作为 User-Agent 信息，不会被请求）。
WIKIMEDIA_CONTACT_URL=
BRAVE_SEARCH_API_KEY=
